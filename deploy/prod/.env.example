# cp .env.example .env and fill in.

# The dataset to serve. A real path on the host — the thing that gets
# snapshotted and backed up, and that later becomes a CephFS mount.
DARAK_DATA=/srv/data

# Where roster.yaml and usersync.yaml live. Version-controlled elsewhere and
# mounted read-only: the accounts are made from these, so they are the change
# that gets reviewed.
DARAK_CONFIG=./config

# The seed usersync derives initial passwords from. Keep it out of the config
# directory so it is not committed with the roster.
DARAK_SEED=./secrets/seed.secret

# TLS. Either point at a certificate and key, or set DARAK_BEHIND_PROXY=1 if
# something in front terminates it — one or the other is required, because
# session cookies are Secure and would never be sent back over plain HTTP.
DARAK_TLS_DIR=./tls
DARAK_TLS_CERT=/etc/darak/tls/fullchain.pem
DARAK_TLS_KEY=/etc/darak/tls/privkey.pem
#DARAK_BEHIND_PROXY=1
#DARAK_HEALTH_URL=http://localhost:8080/

SMB_WORKGROUP=WORKGROUP
SMB_SERVER_STRING=darak
TZ=Asia/Seoul

# usersync is fetched by commit because it has published neither a tag nor a
# usable default branch yet — see deploy/prod/README.md. Replace with a tag as
# soon as there is one.
USERSYNC_VERSION=150bb34eebbcf9bece14c25befcec1b72dde5059
DARAK_VERSION=local

# --- operator page ---------------------------------------------------------
#
# Membership in this POSIX group opens the admin page and its API. It is NOT a
# roster group: a roster group would also get a team folder and an SMB share.
# The entrypoint creates it below the managed band (10000-19999) so usersync
# neither manages it nor complains about it.
#
# Empty DARAK_ADMIN_MEMBERS means nobody can reach the page. Names must be
# accounts the roster declares -- the group is applied after usersync has set
# each user's supplementary groups, so it survives the reconcile.
DARAK_ADMIN_GROUP=admin
DARAK_ADMIN_GID=2000
DARAK_ADMIN_MEMBERS=

# --- signing in with the company account (optional) ------------------------
#
# Leave DARAK_OIDC_ISSUER empty and none of this exists: no button, and every
# /api/sso route answers 404. Everyone signs in with a password, as before.
#
# What this turns on is a second way to prove WHO somebody is. It is not a
# second way to be allowed anything: the account behind an identity comes from
# a mapping an administrator approves, and whether that account may sign in is
# still asked of tdbsam on every attempt. `status: disabled` in roster.yaml
# closes SMB, the password login and this one together, as it always did.
#
# Nobody is registered automatically. An unmapped person who signs in has their
# request recorded and is refused; an administrator then picks their account on
# the operator page. That order exists so nobody has to transcribe addresses in
# advance — a typo there produces a login failure indistinguishable from a
# wrong password.
#DARAK_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#DARAK_OIDC_CLIENT_ID=
#DARAK_OIDC_REDIRECT_URL=https://darak.example.com/api/sso/callback

# The `tid` claim to require. A single-tenant issuer URL (the one above, with a
# tenant id in it) already pins the directory, so this is optional there.
#
# It is MANDATORY for /common, /organizations and /consumers, and darak refuses
# to start without it: those issuers verify a token from ANY directory, each
# asserting whatever address its own tenant put in it. Without the tenant check
# an address means nothing at all.
#DARAK_OIDC_TENANT=

# Address domains to accept, comma-separated. Empty accepts every address the
# tenant asserts, which is usually what you want once the tenant is pinned.
#DARAK_OIDC_EMAIL_DOMAINS=example.com,example.co.kr

# The client secret. Give a path if you have one (a mounted Docker/Kubernetes
# secret), or the value itself — the entrypoint then writes it to a 0600 file
# in the state directory and unsets the variable.
#
# It never becomes a command-line argument: argv is world-readable through
# /proc. It must not stay an environment variable either, because helpers are
# started from the server process and inherit its environment, which would put
# it inside a file readable by each of those users.
#DARAK_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
#DARAK_OIDC_CLIENT_SECRET=

# Auto-provisioning rules. Empty means every unmapped identity waits for an
# administrator, which is the conservative default and the one to start with.
#
# Naming a file here turns on the only path in this system where an account can
# appear without a person acting: darak asks the endpoint in the file to create
# one, waits for it to show up, and signs them in. It never creates the account
# itself, and it only ever binds to an account that did NOT already exist — see
# config/provision.yaml.example, which explains the whole contract.
#
# The file lives under DARAK_CONFIG (mounted read-only at /etc/darak) because it
# is a reviewed artifact like roster.yaml. It is re-read while the server runs;
# a broken edit is reported on the operator page and changes nothing.
#DARAK_PROVISION_CONFIG=/etc/darak/provision.yaml
