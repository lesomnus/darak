# cp .env.example .env and fill in.

# The dataset to serve. A real path on the host — the thing that gets
# snapshotted and backed up, and that later becomes a CephFS mount.
DARAK_DATA=/srv/data

# Where roster.yaml and usersync.yaml live. Version-controlled elsewhere and
# mounted read-only: the accounts are made from these, so they are the change
# that gets reviewed.
DARAK_CONFIG=./config

# The seed usersync derives initial passwords from. Keep it out of the config
# directory so it is not committed with the roster.
DARAK_SEED=./secrets/seed.secret

# TLS. Either point at a certificate and key, or set DARAK_BEHIND_PROXY=1 if
# something in front terminates it — one or the other is required, because
# session cookies are Secure and would never be sent back over plain HTTP.
DARAK_TLS_DIR=./tls
DARAK_TLS_CERT=/etc/darak/tls/fullchain.pem
DARAK_TLS_KEY=/etc/darak/tls/privkey.pem
#DARAK_BEHIND_PROXY=1
#DARAK_HEALTH_URL=http://localhost:8080/

SMB_WORKGROUP=WORKGROUP
SMB_SERVER_STRING=darak
TZ=Asia/Seoul

# usersync is fetched by commit because it has published neither a tag nor a
# usable default branch yet — see deploy/prod/README.md. Replace with a tag as
# soon as there is one.
USERSYNC_VERSION=004a6bd6ac5a945fe3d670cc93abd7ca19a40bf8
DARAK_VERSION=local
