# The integration image is built from a tar on stdin; node_modules would make
# that context enormous and is never needed there — the interface is embedded
# into the binary as committed output, so the image builds Go only.
.git
node_modules
web/node_modules
# Only the repo-root build output: internal/ui/dist is the embedded interface.
/dist

# The bake definition and the compose files describe how to build; they are
# never inputs to a build.
/docker-bake.hcl
/deploy/*/docker-compose.yaml
